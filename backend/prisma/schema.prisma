// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  ADMIN
  SALES
  WAREHOUSE
  ACCOUNTS
}

enum CustomerStatus {
  LEAD
  ACTIVE
  INACTIVE
}

enum CustomerType {
  RETAIL
  WHOLESALE
  DISTRIBUTOR
}

enum ChallanStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum StockMovementType {
  IN
  OUT
}

// ============================================================================
// USERS
// ============================================================================

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  email     String   @unique
  password  String
  fullName  String
  role      UserRole
  isActive  Boolean  @default(true)
  
  // User preferences/settings
  theme     String   @default("light")  // "light" or "dark"
  enableStockAlerts Boolean @default(true)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  customers       Customer[]
  followUps       FollowUp[] @relation("CreatedBy")
  stockMovements  StockMovement[] @relation("CreatedBy")
  challans        Challan[] @relation("CreatedBy")

  @@map("users")
}

// ============================================================================
// CUSTOMERS
// ============================================================================

model Customer {
  id              String         @id @default(cuid())
  name            String
  mobileNumber    String
  email           String
  businessName    String
  gstNumber       String?
  customerType    CustomerType
  address         String
  status          CustomerStatus @default(LEAD)
  followUpDate    DateTime?
  notes           String?
  createdBy       String
  user            User           @relation(fields: [createdBy], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  followUps       FollowUp[]
  challans        Challan[]

  @@index([status])
  @@index([createdBy])
  @@map("customers")
}

model FollowUp {
  id        String   @id @default(cuid())
  customerId String
  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  note      String
  createdBy String
  creator   User     @relation("CreatedBy", fields: [createdBy], references: [id])
  createdAt DateTime @default(now())

  @@index([customerId])
  @@index([createdBy])
  @@map("follow_ups")
}

// ============================================================================
// PRODUCTS & INVENTORY
// ============================================================================

model Product {
  id                    String   @id @default(cuid())
  name                  String
  sku                   String   @unique
  category              String
  unitPrice             Decimal
  currentStock          Int
  minimumStockAlert     Int
  location              String
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  stockMovements        StockMovement[]
  challanItems          ChallanItem[]

  @@index([sku])
  @@index([category])
  @@map("products")
}

model StockMovement {
  id              String            @id @default(cuid())
  productId       String
  product         Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantityChanged Int
  movementType    StockMovementType
  reason          String
  createdBy       String
  creator         User              @relation("CreatedBy", fields: [createdBy], references: [id])
  createdAt       DateTime          @default(now())

  @@index([productId])
  @@index([movementType])
  @@index([createdBy])
  @@map("stock_movements")
}

// ============================================================================
// SALES CHALLANS
// ============================================================================

model Challan {
  id              String        @id @default(cuid())
  challanNumber   String        @unique
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  totalQuantity   Int
  status          ChallanStatus @default(DRAFT)
  createdBy       String
  creator         User          @relation("CreatedBy", fields: [createdBy], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  items           ChallanItem[]

  @@index([challanNumber])
  @@index([status])
  @@index([customerId])
  @@index([createdBy])
  @@map("challans")
}

model ChallanItem {
  id                  String   @id @default(cuid())
  challanId           String
  challan             Challan  @relation(fields: [challanId], references: [id], onDelete: Cascade)
  productId           String
  product             Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  
  // Snapshots - Store product data at time of challan
  productNameSnapshot String
  skuSnapshot         String
  unitPriceSnapshot   Decimal
  quantity            Int
  total               Decimal  @default(0)
  
  createdAt           DateTime @default(now())

  @@index([challanId])
  @@index([productId])
  @@map("challan_items")
}
