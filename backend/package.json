{
  "name": "fundsroom-backend",
  "version": "1.0.0",
  "description": "Mini ERP/CRM Backend API",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "bun run src/seed.ts",
    "db:reset": "prisma migrate reset",
    "prisma:generate": "prisma generate",
    "test": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^5.7.1",
    "@types/cors": "^2.8.19",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "9.0.2",
    "pdfkit": "^0.19.1",
    "puppeteer": "^25.6.0",
    "typescript": "^5.3.3",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.10.6",
    "@types/pdfkit": "^0.17.6",
    "@types/puppeteer": "^5.4.7",
    "@types/uuid": "^9.0.7",
    "prisma": "^5.7.1",
    "ts-node": "^10.9.2",
    "vitest": "^1.1.0"
  }
}
